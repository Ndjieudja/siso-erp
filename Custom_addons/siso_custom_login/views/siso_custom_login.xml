<odoo>
    <data>
        <template id="custom_login_email" inherit_id="web.login">
            <xpath expr="//t" position="replace">
                <div class="row" style="background-color: blue">
                    <div class="col-5" style="background-color: blue;">
                        <t t-call="web.login_layout">
                            <div
                                style="text-align:center;font-weight:bold;font-size:16px;color: whitesmoke;top: -2em;
                                position: relative;">
                                <span>Login</span>
                            </div>
                            <form class="form-fluid" role="form"
                                t-attf-action="/web/login"
                                method="post"
                                onsubmit="this.action = '/web/login' + location.hash">
                                <input type="hidden" name="csrf_token"
                                    t-att-value="request.csrf_token()" />

                                <div class="mb-3 field-login">
                                    <label for="login" style="text-align:left;color: whitesmoke;">
                                        Username</label>
                                    <input type="text" placeholder="Email" name="login"
                                        t-att-value="login" id="login"
                                        t-attf-class="form-control #{'form-control-sm' if form_small else ''}"
                                        required="required" autofocus="autofocus"
                                        autocapitalize="off"
                                        style="
                                            border-top:none;
                                            border-left:none;
                                            border-right:none;
                                            font-size: 16px;
                                            font-weight: bold;
                                            background-color:blue;
                                            color: whitesmoke;"
                                    />
                                </div>

                                <div class="mb-3">
                                    <!-- <label for="password" class="form-label"></label> -->
                                    <input type="password" placeholder="Password"
                                        name="password"
                                        id="password"
                                        t-attf-class="form-control #{'form-control-sm' if form_small else ''}"
                                        required="required" autocomplete="current-password"
                                        t-att-autofocus="'autofocus' if login else None"
                                        maxlength="4096"
                                        style="
                                                border-top:none;
                                                border-left:none;
                                                border-right:none;
                                                font-size: 16px;
                                                font-weight: bold;
                                                background-color:blue;
                                                color: whitesmoke;"
                                    />
                                </div>

                                <div class="mb-3" t-if="databases and len(databases) &gt; 1">
                                    <!-- <label for="db" class="col-form-label"></label> -->

                                    <div
                                        t-attf-class="pos-input {{'input-group-sm' if form_small else ''}}">
                                        <style>
                                            selected: {
                                                position:relative;
                                            }

                                            selected::after {
                                                border-bottom: 2px solid white!important; /* Couleur de la flèche */
                                                border-right: 2px solid white!important;  /* Couleur de la flèche */
                                            }
                                        </style>
                                        <select class="selected" name="db" t-att-value="request.db"
                                            id="db"
                                            required="required" readonly="readonly"
                                            style="
                                                border-top:none 0px;
                                                border-left:none;
                                                border-right:none;
                                                font-size: 16px;
                                                font-weight: bold;
                                                background-color:blue;
                                                color: whitesmoke;
                                                position:relative;
                                                width: 100%"
                                        >
                                            <t t-foreach="databases" t-as="database">
                                                <option t-att-value="database"
                                                    t-att-selected="database == request.db">
                                                    <t t-esc="database" />
                                                </option>
                                            </t>
                                        </select>
                                    </div>
                                </div>

                                <p class="alert alert-danger" t-if="error" role="alert">
                                    <t t-esc="error" />
                                </p>
                                <p class="alert alert-success" t-if="message" role="status">
                                    <t t-esc="message" />
                                </p>

                                <div
                                    t-attf-class="clearfix oe_login_buttons text-center gap-1 d-grid mb-1 {{'pt-2' if form_small else 'pt-3'}}">
                                    <button type="submit" style="background-color:green;"
                                        class="btn btn-primary">Log in</button>
                                    <t t-if="debug">
                                        <button type="submit" name="redirect"
                                            value="/web/become"
                                            class="btn btn-link btn-sm">Log in as superuser</button>
                                    </t>
                                    <div class="o_login_auth" />
                                </div>

                                <input type="hidden" name="redirect" t-att-value="redirect" />
                            </form>
                        </t>
                    </div>

                    <div class="col-7" style="position: relative;">
                        <img t-attf-src="/siso_custom_login/static/src/img/acceuil.jpg"
                            alt="img-acceuil"
                            class="img-fluid"
                            style="width: 100%; height: 100%; object-fit: cover;" />
                    </div>
                </div>
            </xpath>
        </template>

        <template id="hide_link_manage_db" inherit_id="web.login_layout"
            name="Hide Button Manage Db">
            <xpath
                expr="//div[@t-attf-class='card border-0 mx-auto bg-100 {{login_card_classes}} o_database_list']"
                position="attributes">
                <attribute name="style">max-width: 300px;</attribute>
            </xpath>

            <xpath expr="//div[hasclass('card-body')]" position="attributes">
                <attribute name="style">
                    background-color:blue!important;
                </attribute>
            </xpath>

            <xpath expr="//div[hasclass('card-body')]/div[1]" position="attributes">
                <attribute name="style">
                    border-bottom:0!important;
                </attribute>
            </xpath>

            <xpath expr="//div[hasclass('card-body')]/div[1]/img" position="replace">
                <img t-attf-src="/siso_custom_login/static/src/img/acceuil.jpg" alt="Logo" style="max-height:120px; max-width: 100%; width:auto"/>
            </xpath>

        </template>

    </data>
</odoo>