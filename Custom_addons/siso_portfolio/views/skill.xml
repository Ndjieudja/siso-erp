<odoo>

    <record id="siso_skill_action" model="ir.actions.act_window">
        <field name="name">Compétences</field>
        <field name="res_model">siso.skill</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="siso_skill_tree" model="ir.ui.view">
        <field name="model">siso.skill</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="level"/>
            </tree>
        </field>
    </record>

</odoo>