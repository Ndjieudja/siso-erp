<odoo>
    <template id="template_advanced" name="template_name" inherit_id="website.layout">
        <xpath expr="//main" position="inside">
            <div class="container">

                <t t-if="user">
                    <h2>Bonjour <t t-esc="user.name" /></h2>
                </t>

                <t t-else="">
                    <h2>Utilisateur anonyme</h2>
                </t>

            </div>
        </xpath>
    </template>

</odoo>